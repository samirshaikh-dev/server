# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Storage
DATA_DIR=./data

# Local AI / LLM Configuration
# Options: ollama, openai_compatible
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Optional Cloud API Key (if not using local Ollama)
# OPENAI_API_KEY=your_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Whisper Configuration
WHISPER_MODEL=base  # Options: tiny, base, small, medium, large-v3
WHISPER_DEVICE=auto # Options: cuda, cpu, auto
WHISPER_COMPUTE_TYPE=auto # Options: float16, int8, auto

# FFmpeg Executable Override (leave empty to use system PATH or imageio-ffmpeg)
FFMPEG_PATH=
