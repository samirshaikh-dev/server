# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Storage
DATA_DIR=./data

# Redis Queue (optional when running locally, used in Docker)
REDIS_URL=redis://redis:6379/0

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Whisper Configuration
WHISPER_MODEL=base  # Options: tiny, base, small, medium, large-v3
WHISPER_DEVICE=auto # Options: cuda, cpu, auto
WHISPER_COMPUTE_TYPE=auto # Options: float16, int8, auto

# FFmpeg Executable Override (leave empty to use system PATH or imageio-ffmpeg)
FFMPEG_PATH=
